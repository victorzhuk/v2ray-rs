msgstr "Manual recovery required"

msgid "DPI interception degraded: {detail}. The proxy connection stays up."
msgstr "DPI interception degraded: {detail}. The proxy connection stays up."

msgid "the session task has exited; the stop request could not be delivered"
msgstr "the session task has exited; the stop request could not be delivered"

msgid "the session task has exited; the cleanup retry could not be delivered"
msgstr "the session task has exited; the cleanup retry could not be delivered"

